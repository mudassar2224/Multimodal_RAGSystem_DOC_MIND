# Required for hosted inference. Never commit a populated .env file.
HF_TOKEN=
HF_PROVIDER=auto
QWEN_MODEL=Qwen/Qwen3-VL-4B-Instruct
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
VISUAL_RETRIEVAL_MODEL=vidore/colqwen2-v1.0
# Hosted ColQwen/ColPali image-embedding endpoint; generic HF feature extraction is text-only.
VISUAL_ENDPOINT_URL=
ASR_MODEL=openai/whisper-large-v3-turbo
# Use PostgreSQL in deployment, with pgvector enabled. SQLite is only a local/test fallback.
DATABASE_URL=sqlite:///./data/docmind.db
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_DIR=./data/objects
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=200
VIDEO_FRAME_INTERVAL_SECONDS=30
